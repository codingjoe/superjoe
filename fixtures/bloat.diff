@@ -0,0 +1,35 @@
+import json
+import math
+
+
+class ReportFormatter:
+    """Format the rows of one report."""
+
+    def __init__(self, separator: str = ", ", sort_keys: bool = False):
+        self.separator = separator
+        self.sort_keys = sort_keys
+        self.buffer: list[str] = []
+
+    def add(self, row: dict[str, int]) -> None:
+        self.buffer.append(self._join(row))
+
+    def _join(self, row: dict[str, int]) -> str:
+        parts = []
+        for key in row.keys():
+            parts.append(str(row[key]))
+        return self.separator.join(parts)
+
+    def flush(self) -> str:
+        if self.buffer is None:
+            return ""
+        text = ""
+        for part in self.buffer:
+            text += part + "\n"
+        return text
+
+    def to_json(self) -> str:
+        return json.dumps(self.buffer)
+
+
+def distance(left: list[float], right: list[float]) -> float:
+    return math.sqrt(sum((a - b) ** 2 for a, b in zip(left, right)))
