+def cheapest(orders: list[dict], country: str) -> dict:
+    result = None
+    for order in orders:
+        if order["country"] == country:
+            if result is None:
+                result = order
+            else:
+                if order["total"] < result["total"]:
+                    result = order
+    return result
+
+
+def pairs(orders: list[dict]) -> list[tuple[str, str]]:
+    out = []
+    for left in orders:
+        for right in orders:
+            if left["id"] < right["id"] and left["country"] == right["country"]:
+                out.append((left["id"], right["id"]))
+    return out
+
+
+def label(order: dict) -> str:
+    try:
+        return order["customer"]["name"]
+    except:
+        pass
+    return "unknown"
