diff --git a/src/journal/store.py b/src/journal/store.py
--- a/src/journal/store.py
+++ b/src/journal/store.py
@@ -12,3 +12,11 @@
     def add(self, amount_cents: int) -> None:
         """Append an amount to the journal."""
         self.amounts.append(amount_cents)
+
+    def total(self, extra: list[int] = []) -> int:
+        """Sum the journal and the extra amounts."""
+        return sum(self.amounts) + sum(extra)
+
+    def mean(self) -> float:
+        """Average the amounts of the journal."""
+        return sum(self.amounts) / len(self.amounts)
